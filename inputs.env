#relative path to ocel file (with file extension)
#only .json and .sqlite formats are accepted.
path_to_ocel=backend/assets/logs/order-management.json

#format for output i.e. modified ocel
#options: (json, sqlite)
mod_ocel_write_format=json

#options: (mean, max, min, sum)
aggregation_mode=mean

#options: (W, ME, QE, YE)
sampling_rate=W

#options: (starting, ending, contains, overlaps)
#Always applicable for objects. 
#Only applicable for events if they are non-atomic and a valid events_endtime_attribute is provided.
assignment_mechanism=overlaps

#object type representing resources in the log
resource_object_type=employees

#event attribute indicating endtime
events_endtime_attribute=endtime

#if empty, will be replaced by the earliest starting time of an event in the log
time_series_interval_start=2023-06-05 00:00:01+0000

#if empty, will be replaced by the latest ending time of an event in the log
time_series_interval_end=2024-03-02 23:59:59+00:00

#selected tsa technique. 
#options: (Change Point Detection, Granger Causality, Forecasting, Threshold Based Point Detection)
#If empty, execution will stop after time series of measurable properties are generated.
tsa_technique = Change Point Detection

#Enter Y if you want to visualize time series, else N. Saved in assets/plots.
#It is recommended that you disable this option after the first iteration since it will increase runtime.
#That is unless you have selected (via the options in granger causality parameters) to use the data generated from 
#a prior application of threshold based point detection to create new time series in the current iteration 
#for the purpose of including them in the collection of time series to be considered for granger causality 
#and also want to visualize these new time series.
generate_ts_visualizations=Y

#Enter Y if you want to visualize analysis results, else N. Saved in assets/analysis_results_plots.
generate_ar_visualizations=Y

#Enter Y if you want to generate .csv files for time series, else N. Saved in assets/timeseries.
generate_ts_data_files=Y

#Enter Y if you want to generate .json files for analysis results, else N. Saved in assets/analysis_results.
generate_ar_data_files=Y

#See parameters for each tsa technique below.
#Besides Threshold Based Point Detection where specifying parameters is mandatory, you may leave them blank
#and the application will resort to using default values.

#if forecasting has been performed in a previous iteration, set as 'Y' to append the forecasts to the original
#timeseries before applying the selected analysis technique, else set to 'N'. Using this option will produce analysis results
#but no modified OCEL will be produced.
append_forecasts_to_ts = N

#Parameters for Change Point Detection.
#For more details, refer to https://centre-borelli.github.io/ruptures-docs/user-guide/detection/pelt/

#cost model for PELT algorithm. Valid options are: (l1, l2, rbf). Default: rbf
cp_model =

#minimum segment length i.e. minimum distance between change points. Default: 3
cp_min_size =

#controls the grid of possible change points; for instance, if jump=k, only changes at k, 2*k, 3*k,... are considered.
#Default: 1
cp_jump =

#penalty to avoid overfitting. Default: 1.5
cp_penalty =





#Parameters for Granger Causality. 
#For more details, refer to https://www.statsmodels.org/stable/generated/statsmodels.tsa.stattools.grangercausalitytests.html

#If a single integer e.g '4', computes the test for all lags up to gc_lag. 
#If a single integer followed by a comma e.g. '4,', computes the test for only gc_lag. 
#If multiple integers, separated by commas, e.g., '4,8,10', computes the tests only for the lags in gc_lag.
#Default/no value: all values from 1 till maximum possible lag i.e. floor( ( min ( len(ts1), len(ts2) ) - 1 ) / 3 - 1) where
#ts1 and ts2 are the time series for which the test is being performed
#Any value in gc_lag that is above the maximum lag for a series will be discarded
gc_lag = 4,

#alternatively, use change points of time series determined in previous iterations to calculate lags.
#Each change point of ts2 is subtracted from each change point of ts1 and if the result is greater than 0 and less
#than the maximum possible lag then it is used as a lag. ts1, ts2 and maximum possible lag are explained in the
#comments of the parameter above.
#Options(Y,N)
use_change_point_difference_as_lag = N

#p_value threshold (typically lower than 0.1). If the p-value for a granger causality test is below this value,
#then granger causality is implied.
#A lower P-value threshold implies a stronger a criteria for Granger Causality.
#Default: 0.01
gc_p_value_thresh =

#if threshold based point detection has been used in atleast 1 previous iteration(s), set this option to 'Y' to include its results
#in the time series considered for granger causality. Set as 'N', otherwise.
#Using this option will produce analysis results but no modified OCEL will be produced.
use_tbpd_results_as_ts_for_granger_causality = N

#if threshold based point detection has been used in atleast 1 previous iteration(s), set this option to 'Y' to only use its results
#as the time series for granger causality (the original time series will not be used). Set as 'N', otherwise.
#Using this option will produce analysis results but no modified OCEL will be produced.
only_compare_tbpd_ts = N

#if either of the above two options are used, set this to 'Y' if you want to generate visualizations for the newly generated ts. 
#Set as 'N' otherwise.
generate_visualizations_for_tbpd_ts = N


#Parameters for Forecasting
#For more details, refer to https://www.sktime.net/en/stable/api_reference/auto_generated/sktime.forecasting.arima.AutoARIMA.html
#With the exception of fc_periods and fc_maxiter, it is not recommended to amend any other parameters if you are not
#already well-versed with ARIMA. 
#Unreasonable parameter configurations may lead to increased runtime and very inaccurate forecasts.

#Number of time periods to forecast (starting from the period after the end of the time series). 
#Default: 4
#Note that time series with a small length will not produce good forecasts, especially not beyond the first period in 
#the future.
fc_periods =

#use granger causal timeseries (if granger causality has already been performed in a previous iteration) as
#exogenous variables.
use_granger_causal_ts_as_exogenous_variables = N

#The maximum number of function evaluations.
#Default: 100
#Higher values may yield more accurate results but at cost of runtime. 
fc_maxiter =

#starting value for order (or number of time lags) of AR model (non-seasonal component)
#Default: 2
fc_start_p =

#starting value for order (or number of time lags) of MA model (non-seasonal component)
#Default: 2
fc_start_q =

#starting value for order (or number of time lags) of AR model (seasonal component)
#Default: 1
fc_start_P_s =

#starting value for order (or number of time lags) of MA model (seasonal component)
#Default: 1
fc_start_Q_s =

#Maximum value order for order (or number of time lags) of AR model (non-seasonal component)
#Default: 5
fc_max_p =

#Maximum value order for order (or number of time lags) of MA model (non-seasonal component)
#Default: 5
fc_max_q =

#Maximum value order for order (or number of time lags) of AR model (seasonal component)
#Default: 2
fc_max_P_s =

#Maximum value order for order (or number of time lags) of MA model (seasonal component)
#Default: 2
fc_max_Q_s =

#The information criterion used to select the best ARIMA model. 
#Options: (aicc, aic, bic, hqic, oob). Default: aicc
fc_information_criterion =

#Type of unit root test to use in order to detect stationarity if stationary is False and d is None.
#Options: (adf, kpss, pp). Default: kpss
fc_test =





#Parameters for Threshold Based Point Detection
#If this technique is selected, the parameters thresh_pd_mode and thresh_pd_threshold_1 must be provided in all cases.
#Whereas the rest are required in specific cases. See below.

#The metric on which the threshold is applied.
#Options : (quantile, relative change (compared to previous data point), nsmallest, nlargest).
thresh_pd_mode = relative change

#The operator determines how to use the threshold. 
#Only applicable for modes 'quantile' and 'relative change' where it must be provided.
#Options: (between, greater or equal to, lesser or equal to).
thresh_pd_comparison_operator = lesser or equal to

#Thresholds for quantile must be between 0 and 1 and upper threshold must greater than Lower Threshold.
#Thresholds for relative change represent fractional change compared to previous data point i.e. percentage change/100. 
#Hence they can be both negative/positive.
#Threshold for nsmallest and nlargest is a positive integer.
#Primary/Lower Threshold value.
thresh_pd_threshold_1 = -0.05

#Upper threshold value, only applicable for comparison operator 'between' where it must be provided.
thresh_pd_threshold_2 = 