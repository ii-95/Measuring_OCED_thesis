      <block id="ID1413073870">
        <id>Functions</id>
        <ml id="ID1413074668">fun create_items(0, _) = [] | create_items(ct: INT, objid: INT) =
let 
val it = &quot;i&quot;^(Int.toString objid)
in
it::create_items(ct-1, objid+1)
end;
          <layout>fun create_items(0, _) = [] | create_items(ct: INT, objid: INT) =
let 
val it = &quot;i&quot;^(Int.toString objid)
in
it::create_items(ct-1, objid+1)
end;</layout>
        </ml>
        <ml id="ID1418183485">fun random_number_of_items(pp: REAL, objid: INT) = 
let
val number_of_items = round(real(poisson(2.0*(1.0+pp/100.0)) + 1));
in
create_items(number_of_items, objid)
end;
          <layout>fun random_number_of_items(pp: REAL, objid: INT) = 
let
val number_of_items = round(real(poisson(2.0*(1.0+pp/100.0)) + 1));
in
create_items(number_of_items, objid)
end;</layout>
        </ml>
      </block>
