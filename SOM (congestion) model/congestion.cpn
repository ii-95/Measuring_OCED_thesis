      <block id="ID1413138814">
        <id>More functions</id>
        <ml id="ID1413139466">fun expb_h(av:real,high:real) = let val x = exponential(1.0/av) in if x &gt; high then expb_h(av,high) else x end:real;
          <layout>fun expb_h(av:real,high:real) = let val x = exponential(1.0/av) in if x &gt; high then expb_h(av,high) else x end:real;</layout>
        </ml>
        <ml id="ID1413140151">fun expb(av:real,high:real) =norm_r_st_delay(expb_h(av,high));
          <layout>fun expb(av:real,high:real) =norm_r_st_delay(expb_h(av,high));</layout>
        </ml>
      </block>
